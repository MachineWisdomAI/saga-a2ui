{
  "name": "saga-lit-hapi-starter",
  "private": true,
  "description": "A SAGA A2UI starter: a Lit view served by a Hapi MCP server.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build:view": "vite build",
    "build:server": "vite build --config vite.server.config.ts",
    "build": "npm run build:view && npm run build:server",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "start": "node dist/server.mjs"
  },
  "dependencies": {
    "@a2ui/lit": "0.13.0",
    "@a2ui/web_core": "0.13.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@saga-a2ui/core": "*",
    "@saga-a2ui/lit": "*",
    "@saga-a2ui/mcp": "*",
    "lit": "^3.3.3",
    "zod": "4.6.7",
    "@hapi/hapi": "21.4.10"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "2.3.3"
  },
  "overrides": {
    "@a2ui/markdown-it": "0.2.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
