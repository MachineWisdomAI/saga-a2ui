{
  "name": "saga-lit-express-starter",
  "private": true,
  "description": "A saga a2ui starter: a Lit view served by an Express MCP server.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build:view": "vite build",
    "build:server": "vite build --config vite.server.config.ts",
    "build": "npm run build:view && npm run build:server",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "start": "node dist/server.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/express": "2.0.2",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@saga-a2ui/components": "*",
    "@saga-a2ui/core": "*",
    "@saga-a2ui/lit": "*",
    "@saga-a2ui/lit-mcp-stack": "*",
    "@saga-a2ui/mcp": "*",
    "express": "5.3.0",
    "lit": "^3.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "2.3.3"
  },
  "overrides": {
    "@a2ui/markdown-it": "0.2.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
