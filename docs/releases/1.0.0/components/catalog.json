        "to": "<footer><SagaAttribution links={links} /></footer>",
        "language": "tsx",
        "code": "import {SagaAttribution, startA2uiView, type HostLinks} from '@saga-a2ui/react-mcp-stack';\nimport '@saga-a2ui/react-mcp-stack/attribution.css';\n\nlet links: HostLinks | undefined;\nstartA2uiView({\n  // ...\n  actions: (host) => {\n    links = host.links; // asks the host to open a link; ends with the view\n    return undefined;\n  },\n});\n\n// Wherever the application renders its footer:\n<footer><SagaAttribution links={links} /></footer>"
      },
      "route": "/docs/releases/1.0.0/components/saga-attribution",
