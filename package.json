{
  "name": "saga-a2ui-workspace",
  "private": true,
  "type": "module",
  "description": "SAGA A2UI SDK workspace",
  "scripts": {
    "start": "npm run start -w @saga-a2ui/lit-host-app",
    "build": "npm run build -w @saga-a2ui/lit-host-app",
    "serve:mcp": "npm run serve:mcp -w @saga-a2ui/lit-host-app",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck -w @saga-a2ui/core && npm run typecheck -w @saga-a2ui/lit && npm run typecheck -w @saga-a2ui/react && npm run typecheck -w @saga-a2ui/mcp && npm run typecheck -w @saga-a2ui/lit-host-app",
    "test:browser": "npm run test:browser -w @saga-a2ui/lit-host-app",
    "test:headless": "vitest run",
    "candidate:identity": "tsx scripts/candidate-identity.ts",
    "verify": "tsx scripts/verify.ts"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "jsdom": "28.1.0"
  },
  "overrides": {
    "@a2ui/markdown-it": "0.2.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/MachineWisdomAI/saga-a2ui.git"
  }
}
