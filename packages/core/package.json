{
  "name": "@saga-a2ui/core",
  "private": false,
  "description": "saga a2ui core: decode and validate A2UI messages, define surfaces, and run actions, independent of any renderer",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./actions": "./src/actions/index.ts",
    "./actions/action-button-schema": "./src/actions/action-button-schema.ts",
    "./conversation": "./src/conversation.ts",
    "./delivered-result": "./src/delivered-result.ts",
    "./host-links": "./src/host-links.ts",
    "./protocols/a2ui/v0_9": "./src/protocols/a2ui/v0_9/index.ts",
    "./protocols/a2ui/zod3": "./src/protocols/a2ui/zod3.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test-support.ts"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@a2ui/web_core": "0.13.0",
    "zod3": "npm:zod@3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "^5.9.0",
    "vitest": "^5.0.4"
  },
  "version": "0.13.0-rc.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MachineWisdomAI/saga-a2ui.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  }
}
