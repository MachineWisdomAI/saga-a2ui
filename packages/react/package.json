      "optional": true
    }
  },
  "devDependencies": {
    "@saga-a2ui/components": "*",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "28.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^5.9.0",
    "vitest": "^5.0.4"
  }
