{
  "name": "@saga-a2ui/react-mcp-stack",
  "private": false,
  "description": "The React and MCP Apps stack for SAGA A2UI: starts a view for an application's own catalog, and a FaithfulCard application from one validated definition, so an application installs one stack plus React and writes only its own decisions",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./faithful-card": "./src/faithful-card/index.ts",
    "./content-policy": "./src/content-policy/index.ts",
    "./server": "./src/server/index.ts",
    "./faithful-card.css": "./src/faithful-card/faithful-card.css"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test-support.ts"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@saga-a2ui/components": "0.7.6",
    "@saga-a2ui/core": "0.7.6",
    "@saga-a2ui/mcp": "0.7.6",
    "@saga-a2ui/react": "0.7.6",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "28.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^5.9.0",
    "vitest": "^5.0.4"
  },
  "version": "0.7.6",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MachineWisdomAI/saga-a2ui.git",
    "directory": "packages/react-mcp-stack"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  }
}
