{
  "name": "@saga-a2ui/lit",
  "private": false,
  "description": "Lit binding for SAGA A2UI: mounts a core message session's surface with an application's own catalog and owns its disposal, with the optional /actions control and instance host and the optional /faithful-card element",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./actions": "./src/actions/index.ts",
    "./faithful-card": "./src/faithful-card/index.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test-support.ts"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@a2ui/lit": "0.13.0",
    "@a2ui/web_core": "0.13.0",
    "@saga-a2ui/core": "0.9.0-rc.1",
    "lit": "^3.3.3"
  },
  "peerDependencies": {
    "@saga-a2ui/components": "0.9.0-rc.1"
  },
  "peerDependenciesMeta": {
    "@saga-a2ui/components": {
      "optional": true
    }
  },
  "devDependencies": {
    "@saga-a2ui/components": "0.9.0-rc.1",
    "typescript": "^5.9.0",
    "vitest": "^5.0.4"
  },
  "version": "0.9.0-rc.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MachineWisdomAI/saga-a2ui.git",
    "directory": "packages/lit"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  }
}
