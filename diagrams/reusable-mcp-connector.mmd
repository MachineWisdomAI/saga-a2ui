flowchart TD
  L["Application listener<br/>verified request identity"] --> S["SAGA server registration<br/>validated business arguments"]
  P["Explicit public operation<br/>no invented identity"] --> S
  S --> H["Application handler<br/>authorization and backend work"]
  H --> R["Application selects allowed fields;<br/>SDK validates the ordinary result"]
  R --> M["Model-visible content<br/>and structured data"]
  R --> V["SAGA view lifecycle<br/>handshake, input and result"]
  S --> A["Static resource and<br/>declared resource policy"]
  A --> V
  V --> UI["Application state and renderer"]
  H -->|"refused, failed or retired"| F["Bounded safe failure<br/>no late success"]
  F --> UI
  Q["Specialized private result:<br/>application owns upstream mapping<br/>and claimed-host evidence"] -.-> R
