flowchart TD
  C["Client action sends request"] --> L["Listener admission<br/>one request deadline and signal"]
  L --> A["Authenticate and read body,<br/>or check media capability and proof"]
  A --> W["Bounded handler stages<br/>authorization, storage, projection"]
  W -->|"valid result before deadline"| R["Choose one response"]
  R --> F["Finish response within the<br/>remaining request budget"]
  L -.->|"deadline"| D{"Response committed?"}
  D -->|"no"| E["Safe failure if the transport<br/>still permits a response"]
  D -->|"yes"| X["End or close the response"]
  L -.->|"caller disconnects"| N["Retire without a response"]
  E --> Z["Drop late results;<br/>start no later stage"]
  X --> Z
  N --> Z
  C -.->|"client cancellation does not prove"| U["Server termination or<br/>rollback of prior effects"]
  K["An issued media capability<br/>keeps its own expiry"] -->|"fresh acquisition"| L
