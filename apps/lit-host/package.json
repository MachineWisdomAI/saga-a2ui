{
  "name": "@saga-a2ui/lit-host-app",
  "private": true,
  "description": "Minimal Lit application used to prove the workspace builds and renders",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "vite build && vite build --config vite.view.config.ts && vite build --config vite.host-fixture.config.ts",
    "serve:mcp": "tsx src/mcp/serve.ts",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test:browser": "playwright test",
    "test:headless": "vitest run"
  },
  "dependencies": {
    "@a2ui/lit": "0.13.0",
    "@a2ui/web_core": "0.13.0",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "lit": "^3.3.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "^5.0.4"
  }
}
